--!strict
local RunService = game:GetService("RunService")

local Services = script.Parent:WaitForChild("services")
local WorldService = require(Services:WaitForChild("WorldService"))
local StreetDetailService = require(Services:WaitForChild("StreetDetailService"))
local SprintService = require(Services:WaitForChild("SprintService"))
local VehicleService = require(Services:WaitForChild("VehicleService"))
local DistrictService = require(Services:WaitForChild("DistrictService"))
local GarageService = require(Services:WaitForChild("GarageService"))
local ProfileService = require(Services:WaitForChild("ProfileService"))
local PersonalGarage = require(Services:WaitForChild("PersonalGarage"))
local HousingService = require(Services:WaitForChild("HousingService"))
local WantedService = require(Services:WaitForChild("WantedService"))
local DistrictSocietyService = require(Services:WaitForChild("DistrictSocietyService"))
local TerritoryService = require(Services:WaitForChild("TerritoryService"))
local CrewService = require(Services:WaitForChild("CrewService"))
local PropertyService = require(Services:WaitForChild("PropertyService"))
local NatureService = require(Services:WaitForChild("NatureService"))
local BankNetworkService = require(Services:WaitForChild("BankNetworkService"))
local PropertyMarketService = require(Services:WaitForChild("PropertyMarketService"))
local TrafficService = require(Services:WaitForChild("TrafficService"))
local PublicTransitService = require(Services:WaitForChild("PublicTransitService"))
local NpcLifeService = require(Services:WaitForChild("NpcLifeService"))
local CitizenService = require(Services:WaitForChild("CitizenService"))
local CityJobsService = require(Services:WaitForChild("CityJobsService"))
local LegalCareerService = require(Services:WaitForChild("LegalCareerService"))
local WeatherService = require(Services:WaitForChild("WeatherService"))
local ReputationService = require(Services:WaitForChild("ReputationService"))
local TrafficSignalService = require(Services:WaitForChild("TrafficSignalService"))
local DistrictDetailService = require(Services:WaitForChild("DistrictDetailService"))
local CityLandmarkService = require(Services:WaitForChild("CityLandmarkService"))
local CityInfillService = require(Services:WaitForChild("CityInfillService"))
local BoxingService = require(Services:WaitForChild("BoxingService"))
local CrimeEconomyService = require(Services:WaitForChild("CrimeEconomyService"))
local LifestyleService = require(Services:WaitForChild("LifestyleService"))
local ArmoryService = require(Services:WaitForChild("ArmoryService"))
local BountyService = require(Services:WaitForChild("BountyService"))
local LifeAndDeathService = require(Services:WaitForChild("LifeAndDeathService"))
local RaceService = require(Services:WaitForChild("RaceService"))
local GarageMarketplaceService = require(Services:WaitForChild("GarageMarketplaceService"))
local StartupContract = require(Services:WaitForChild("StartupContract"))
local WorldSurfaceAudit = require(Services:WaitForChild("WorldSurfaceAudit"))

local success, err = pcall(function()
    ProfileService.Start() -- Uses isolated memory-only profiles in unpublished Studio
    WantedService.Start()
    DistrictSocietyService.Start() -- incidents affect local population, safety and property index
    ReputationService.Start()
    WorldService.Start()
    StreetDetailService.Start() -- Continuous pedestrian paths, street markings and lamps
    SprintService.Start() -- Server-controlled sprint on desktop, mobile and gamepad
    WeatherService.Start()
    DistrictService.Start()
    DistrictDetailService.Start()
    CityLandmarkService.Start()
    TrafficSignalService.Start()
    HousingService.Start() -- Homes exist before personal vehicle spawn and respawn
    local testCar = VehicleService.Start()
    if testCar then GarageService.Start(testCar) end
    PersonalGarage.Start()
    GarageMarketplaceService.Start()
    RaceService.Start()
    CityJobsService.Start()
    LegalCareerService.Start()
    CrimeEconomyService.Start()
    PropertyMarketService.Start()
    LifestyleService.Start()
    BoxingService.Start()
    CitizenService.Start()
    NpcLifeService.Start()
    BountyService.Start() -- before armed hits and death settlement
    LifeAndDeathService.Start() -- before first player death
    ArmoryService.Start()
    NatureService.Start()
    CrewService.Start()
    PropertyService.Start()
    TerritoryService.Start()
    BankNetworkService.Start()
    CityInfillService.Start() -- Only occupy free parcels after homes, jobs and shops exist
    TrafficService.Start()
    PublicTransitService.Start()
    WorldSurfaceAudit.Validate() -- fail launch on missing drivable roads or unsafe home surfaces
    StartupContract.Validate()
    if RunService:IsStudio() then
        require(script.Parent:WaitForChild("dev"):WaitForChild("SmokeTests")).Run()
        require(script.Parent:WaitForChild("dev"):WaitForChild("CityTraversalTests")).Run()
        require(script.Parent:WaitForChild("dev"):WaitForChild("CityInfillTests")).Run()
        require(script.Parent:WaitForChild("dev"):WaitForChild("WorldTraversalTests")).Run()
        require(script.Parent:WaitForChild("dev"):WaitForChild("TrafficSafetyTests")).Run()
        require(script.Parent:WaitForChild("dev"):WaitForChild("VehicleDamageTests")).Run()
        require(script.Parent:WaitForChild("dev"):WaitForChild("ScenarioTests")).Run()
        require(script.Parent:WaitForChild("dev"):WaitForChild("SimulationTests")).Run()
        require(script.Parent:WaitForChild("dev"):WaitForChild("CityLifeTests")).Run()
        require(script.Parent:WaitForChild("dev"):WaitForChild("LegalCareerTests")).Run()
        require(script.Parent:WaitForChild("dev"):WaitForChild("LifeEconomyTests")).Run()
        require(script.Parent:WaitForChild("dev"):WaitForChild("DistrictEconomyTests")).Run()
        require(script.Parent:WaitForChild("dev"):WaitForChild("SocialSystemsTests")).Run()
    end
end)

if not success then
    error("[StreetCity] Failed to start: " .. tostring(err))
end

print("[StreetCity] Prototype server ready; manual multiplayer/physics test required.")
